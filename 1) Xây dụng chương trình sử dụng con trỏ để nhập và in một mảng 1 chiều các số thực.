#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, i;
    float *a;

    printf("Nhap so phan tu: ");
    scanf("%d", &n);

    a = (float *)malloc(n * sizeof(float));

    if (a == NULL) {
        printf("Khong du bo nho!");
        return 1;
    }

    printf("Nhap mang:\n");
    for (i = 0; i < n; i++) {
        scanf("%f", a + i);
    }

    printf("Mang vua nhap:\n");
    for (i = 0; i < n; i++) {
        printf("%.2f\t", *(a + i));
    }

    free(a);

    return 0;
}
