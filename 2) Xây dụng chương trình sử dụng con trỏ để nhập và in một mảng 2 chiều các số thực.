#include <stdio.h>
#include <stdlib.h>

int main() {
    int h, c, i, j;
    float **a;

    printf("Nhap so hang va so cot: ");
    scanf("%d%d", &h, &c);

    a = (float **)malloc(h * sizeof(float *));

    if (a == NULL) {
        printf("Khong du bo nho!");
        return 1;
    }

    for (i = 0; i < h; i++) {
        a[i] = (float *)malloc(c * sizeof(float));
    }

    printf("Nhap ma tran:\n");
    for (i = 0; i < h; i++) {
        for (j = 0; j < c; j++) {
            scanf("%f", *(a + i) + j);
        }
    }

    printf("Ma tran vua nhap:\n");
    for (i = 0; i < h; i++) {
        for (j = 0; j < c; j++) {
            printf("%.2f\t", *(*(a + i) + j));
        }
        printf("\n");
    }

    for (i = 0; i < h; i++) {
        free(a[i]);
    }
    free(a);

    return 0;
}
